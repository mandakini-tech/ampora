# ==============================================================================
# AMPORA BACKEND SERVER ENVIRONMENT CONFIGURATION
# ==============================================================================

PORT=5000
NODE_ENV=development

# Supabase Project URL
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Secret Key (in newer Supabase dashboards, this is labeled "Secret key";
# in older dashboards it was labeled "service_role key". Both work!)
SUPABASE_SECRET_KEY=your-supabase-secret-key-here
# or:
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Optional: Supabase Publishable Key
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here

# Frontend dev origin
CORS_ORIGIN=http://localhost:3000
