{
  "name": "ampora-electricity-management-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Ampora - Electricity Billing Management System (Frontend & Backend)",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev --prefix frontend",
    "dev:frontend": "npm run dev --prefix frontend",
