# ==============================================================================
# AMPORA FRONTEND ENVIRONMENT CONFIGURATION
# ==============================================================================

# Supabase Project URL (e.g. https://abcdefghijklm.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Publishable Key (in newer Supabase dashboards, this is labeled "Publishable key";
# in older dashboards it was labeled "anon public key". Both work!)
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here
# or:
# VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Optional Backend REST API Base URL (if using Express backend)
VITE_API_BASE_URL=http://localhost:5000/api
